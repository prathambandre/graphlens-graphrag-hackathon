# GraphLens Configuration
# Copy this file to .env and fill in your values

# Mode: "mock" (default, no API keys needed) or "live"
MODE=mock

# LLM Provider: "groq", "openai", "gemini", "ollama"
LLM_PROVIDER=groq

# Groq (Free tier - sign up at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Optional - free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# TigerGraph (Optional - for production GraphRAG)
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_GRAPH_NAME=GraphLens
TG_USE_MOCK=true
